s,clusterer,drawing\"><\/script>\n              <style>\n                #map { width: 500px; height: 400px; }\n              </style>\n              \n              \n            </head>\n            <body>\n              <div id=\"map\"></div>\n              <script type=\"text/javascript\">\n                var marker;\n                var map; \n                var bounds;\n\n                function initMap() {\n                  var container = document.getElementById('map');\n                  var options = {\n                    center: new kakao.maps.LatLng(35.8344469, 128.680506),\n                    level: 2\n                  };\n                  map = new kakao.maps.Map(container, options);\n                  \n                  "+n+"\n                }\n\n                // \uc704\uce58\uc815\ubcf4 \ubaa9\ub85d\uc5d0\uc11c \uc120\ud0dd\uc88c\ud45c, \ub9c8\ucee4\uc774\ubbf8\uc9c0\ub85c \uc9c0\ub3c4 \uc911\uc559\uac12 \uc774\ub3d9 \ucc98\ub9ac\n                function moveToMarkerLocation(lat, lng, img, markerWid, markerHei) {\n\n                    // \ud604\uc7ac \uc9c0\ub3c4\uc758 \ub808\ubca8\uc744 \uc5bb\uc5b4\uc635\ub2c8\ub2e4\n                    var level = map.getLevel();\n                    \n                    if(level > 1) {\n                        // \uc9c0\ub3c4\uac00 \ucd95\uc18c \ubaa8\ub4dc\uc77c \uacbd\uc6b0, level = 1\ub85c \ucd5c\ub300 \ud655\ub300\ucc98\ub9ac\n                        map.setLevel(1);\n                    }\n\n                    var markerImage = new kakao.maps.MarkerImage(\n                        img,\n                        new kakao.maps.Size(markerWid, markerHei), new kakao.maps.Point(34, 34));\n                    marker.setImage(markerImage);\n\n                    var moveLatLon = new kakao.maps.LatLng(lat, lng);\n                    map.panTo(moveLatLon);\n                    marker.setPosition(moveLatLon);\n                }\n\n                function zoomIn() {\n                    // \ud604\uc7ac \uc9c0\ub3c4\uc758 \ub808\ubca8\uc744 \uc5bb\uc5b4\uc635\ub2c8\ub2e4\n                    var level = map.getLevel();\n                    \n                    // \uc9c0\ub3c4\ub97c 1\ub808\ubca8 \ub0b4\ub9bd\ub2c8\ub2e4 (\uc9c0\ub3c4\uac00 \ud655\ub300\ub429\ub2c8\ub2e4)\n                    map.setLevel(level - 1);\n                }\n\n                // \uc9c0\ub3c4\ubc94\uc704 \uc7ac\uc124\uc815 \ud568\uc218\n                function reDrawMap(coordinates, markers) {\n                    // var points = [\n                    //     new kakao.maps.LatLng(35.857356999067505, 128.50396669226538),\n                    //     new kakao.maps.LatLng(35.8344588, 128.6805186)\n                    // ];\n\n                    if(coordinates != null) {\n                        // alert(\"\ud30c\ub77c\ubbf8\ud130 : \" + coordinates.length);\n                        // alert(\"\uccab\ubc88\uc9f8 \uc704\uacbd\ub3c4 : \" + coordinates[0].lat + \", \" + coordinates[0].lng);\n                    }else {\n                        alert(\"reDrawMap caxlled !\")\n                    }\n\n                    let point, markerImage;\n                    bounds = new kakao.maps.LatLngBounds(); \n                    for (i = 0; i < coordinates.length; i++) {\n                        point = new kakao.maps.LatLng(coordinates[i].lat, coordinates[i].lng);\n                        markerImage = new kakao.maps.MarkerImage(\n                            markers[i].imgSrc,\n                            new kakao.maps.Size(markers[i].height, markers[i].width), new kakao.maps.Point(34, 34));\n\n                        // alert(i + \"\ubc88\uc9f8 : \" + point);\n                        marker = new kakao.maps.Marker({ position : point });\n                        marker.setImage(markerImage);\n                        // marker.setMap(map);                        \n                        bounds.extend(point);\n                    }\n                    \n                    // for (i = 0; i < points.length; i++) {\n                    //     marker = new kakao.maps.Marker({ position : points[i] });\n                    //     alert(i + \"\ubc88\uc9f8 : \" + points[i]);\n                    //     marker.setMap(map);                        \n                    //     bounds.extend(points[i]);\n                    // }\n                    map.setBounds(bounds); \n                }\n\n                window.onload = initMap;\n\n              <\/script>\n            </body>\n          </html>\n        "})(j)},geolocationEnabled:!0,javaScriptEnabled:!0})),o.default.createElement(c.Animated.ScrollView,{scrollEventThrottle:10,onScroll:function(e){var t=e.nativeEvent.contentOffset.y;Q.setValue(t)}},o.default.createElement(c.View,{style:{flex:.25,paddingTop:30,paddingHorizontal:20}},o.default.createElement(c.Text,{style:[T.fsTitle,T.fontBold]},"\uc704\uce58\uc815\ubcf4"),o.default.createElement(c.Text,{style:[T.fsSubTitle]},"\uceec\ub7ec \uc11c\ud074\uc744 \uc120\ud0dd\ud558\uba74, \ud574\ub2f9 \uc704\uce58\ub97c \uc9c0\ub3c4\uc5d0\uc11c \ud558\uc774\ub77c\uc774\ud2b8 \ucc98\ub9ac\ub429\ub2c8\ub2e4.")),o.default.createElement(c.FlatList,{style:{flex:2},data:j,renderItem:function(e){var t,n=e.item,l=e.index,s=T["btnTrack"+String(Math.round(l/2)).padStart(2,"0")];if("clockIn"==n.state||"clockOut"==n.state)t=k.switchDomain(C)+"/img/ico/ico_circle.png";else{var u=String(Math.round(l/2)).padStart(2,"0");t="MOVE"==n.state?k.switchDomain(C)+"/img/ico/ico_move_"+u+".png":k.switchDomain(C)+"/img/ico/ico_arrive_"+u+".png"}return o.default.createElement(c.View,{style:{paddingHorizontal:20}},"clockIn"==n.state||"clockOut"==n.state?o.default.createElement(c.TouchableOpacity,{style:{flex:1}},o.default.createElement(c.View,{style:{flex:1,flexDirection:'column'}},'clockIn'==n.state?o.default.createElement(c.View,{style:{flexDirection:'row'}},o.default.createElement(c.View,{style:{flexDirection:'column',alignItems:'center',marginLeft:11}},o.default.createElement(c.View,{style:[T.